fn main() {
   while {
      let code = input(" > ")
      break unless code != "quit"

      let memory = [].fill(500, char())
      let pointer = memory.size() / 2

      for let i = 0; code.in(i); i++ {
         let ch = code.get(i)

         if ch == '>' do
            pointer++
         elif ch == '<' do
            pointer--
         elif ch == '+' do
            memory.set(pointer, memory.get(pointer)++)
         elif ch == '-' do
            memory.set(pointer, memory.get(pointer)--)
         elif ch == '.' do
            print(char(memory.get(pointer)))
         elif ch == ',' do
            memory.set(pointer, inputch())
         elif ch == '[' {
            continue unless memory.get(pointer) == 0
            let depth = 1

            for i++; code.in(i) && depth > 0; i++ do
               if code.get(i) == '[' do
                  depth++
               elif code.get(i) == ']' do
                  depth--
         } elif ch == ']' {
            continue unless memory.get(pointer) != 0
            let depth = 1

            for i--; code.in(i) && depth > 0; i-- do
               if code.get(i) == '[' do
                  depth--
               elif code.get(i) == ']' do
                  depth++
         }
      }
   }
}
